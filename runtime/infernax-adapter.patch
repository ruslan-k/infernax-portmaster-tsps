+    /* The patch table below is pinned to one title's main.text; any other title
+     * is refused by an identity stop. Opt in only for the title it was measured on. */
+    const char *env=getenv("NX_LAZY_MESH");
+    if(!env || strcmp(env,"1")){printf("lazy-mesh patches not applied (title-pinned; NX_LAZY_MESH=1 opts in)\n");return;}
     const struct image_segment *t=NULL;
     for(size_t i=0;i<nsegs;i++)if(!strcmp(segs[i].name,"main.text.seg"))t=&segs[i];
     if(!t || t->file_size!=T2_LAZY_MESH_TEXT_SIZE)stop("T2_LAZY_MESH_SEGMENT",t?t->base:0,t?t->file_size:0,24);
