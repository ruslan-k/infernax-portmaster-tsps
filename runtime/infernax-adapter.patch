diff --git a/native/t2_lazy_mesh.h b/native/t2_lazy_mesh.h
index 3da35a8..1b6ef9a 100644
--- a/native/t2_lazy_mesh.h
+++ b/native/t2_lazy_mesh.h
@@ -48,8 +48,10 @@ static const struct t2_lazy_mesh_patch { uint64_t offset; uint32_t length; int b
 /* Called by loader.c right after the segments are read (still writable, before bridges/TLS stubs and rtld).
  * Default ON; any identity mismatch stops with a named status instead of half-patching. */
 static void t2_lazy_mesh_apply(const struct image_segment *segs,size_t nsegs) {
-    const char *env=getenv("T2_LAZY_MESH");
